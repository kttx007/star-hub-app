# ---------------------------------------------------------------
# Agnes AI 配置示例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会入库。
# ---------------------------------------------------------------

# API Key，在 https://platform.agnes-ai.com/settings/apiKeys 创建
# 给 scripts/agnes.mjs（命令行 / Claude Code 会话）使用
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 仅本地开发时给前端用。注意：vite build 会把 VITE_ 开头的变量
# 内联进静态产物，任何人都能从 bundle 里读出来。
# 只在自己机器上 npm run dev 时使用，不要用于对外部署。
# 推荐留空，改用界面里的「BYOK 设置」把 key 存进 localStorage。
VITE_AGNES_API_KEY=

# 可选：覆盖默认 API 根地址
# VITE_AGNES_BASE_URL=https://apihub.agnes-ai.com
